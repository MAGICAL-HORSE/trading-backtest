# ============================================================
# Options Day Trading Bot — Environment Variables
# Copy to .env and fill in your actual keys.
# NEVER commit your real .env to version control.
# ============================================================

# ── Polygon.io ───────────────────────────────────────────────
# Real-time market data, options chains, Greeks, screener
# Sign up: https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=Z63HLFieKMvis9fVjcpSv9I0Z9DdkPVn

# ── Tradier ──────────────────────────────────────────────────
# Broker for order execution (paper + live)
# Sign up: https://developer.tradier.com/
TRADIER_API_KEY=EEXiqSsBDCTtKBVlQY6SQbrHyNrz
TRADIER_ACCOUNT_ID=VA50054656

# ── Benzinga ─────────────────────────────────────────────────
# News feed for biotech catalyst detection
# Sign up: https://www.benzinga.com/apis/
BENZINGA_API_KEY=bz.TFWLOEODHN5ZKKK44TWF3ATOW2NXH4NY

# ── Trading Mode Flags ───────────────────────────────────────
# Set LIVE_TRADING=true to route orders to real money.
# DEFAULT: false (paper trading via Tradier sandbox)
LIVE_TRADING=false

# Set BACKTEST=true to replay history with Polygon historical data.
# Mutually exclusive with live/paper trading.
BACKTEST=false

# ── Capital ──────────────────────────────────────────────────
# Total account value used for position sizing math.
# In paper mode this is purely virtual; must match Tradier paper balance.
ACCOUNT_CAPITAL=25000.00

# ── Timezone ─────────────────────────────────────────────────
# All time comparisons use this zone (must match market hours logic).
TZ=America/chicago
